FROM node:24.15.0-slim AS frontend
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY dashboard/ dashboard/
RUN npm ci --ignore-scripts && npm run build

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
WORKDIR /app
ENV UV_LINK_MODE=copy UV_NO_DEV=1
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-install-project --only-group server
COPY backend/ backend/
COPY data/customer_orders.json data/customer_orders.json
COPY data/security/customer_orders.json data/security/customer_orders.json
COPY docs/shopping-policy.md docs/cancellation-policy.md docs/returns-policy.md docs/
COPY --from=frontend /app/dashboard/dist dashboard/dist
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
CMD [".venv/bin/uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
