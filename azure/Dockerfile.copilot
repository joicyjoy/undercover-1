FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
WORKDIR /app
ENV UV_LINK_MODE=copy UV_NO_DEV=1
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-install-project --only-group runtime
COPY agent/ agent/
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 8080
CMD [".venv/bin/uvicorn", "agent.copilot_entrypoint:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips=*"]
